PORT=4000

# Neon connection string. Copy it from the Neon console (Connection string,
# Node.js / pg driver) - it already includes ?sslmode=require, keep that.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-xxxx.aws.neon.tech/neondb?sslmode=require

# Tests TRUNCATE their tables, so they need a SEPARATE database.
# Create it once in the Neon SQL editor:  CREATE DATABASE miniledger_test;
TEST_DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-xxxx.aws.neon.tech/miniledger_test?sslmode=require

JWT_SECRET=change-me-to-something-long-and-random
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
DEFAULT_COUNTRY_CODE=+91
CORS_ORIGIN=*
UPLOAD_DIR=uploads
MAX_RECEIPT_BYTES=5242880
