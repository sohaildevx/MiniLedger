# Copy to .env and set this to YOUR computer's LAN IP while developing on a
# physical phone. Run `ipconfig` (Windows) or `ifconfig` (macOS) to find it.
#
#   Android emulator  -> http://10.0.2.2:4000
#   iOS simulator     -> http://localhost:4000
#   Physical phone    -> http://<your-LAN-IP>:4000   (same Wi-Fi as your computer)
#
# "localhost" on a physical phone means the phone itself, not your laptop -
# that is the single most common reason the app appears to do nothing.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
